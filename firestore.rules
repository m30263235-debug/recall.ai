rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Connection health check route (as mandated by skill)
    match /test/connection {
      allow read: if true;
    }

    // User profile documents (strict PII protection: only the owner can read/write their profile)
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list: if false;
      allow create: if isOwner(userId) && incoming().userId == userId;
      allow update: if isOwner(userId) && incoming().userId == userId;
      allow delete: if isOwner(userId);

      // User notes subcollection (complete isolation per user)
      match /notes/{noteId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(noteId) && incoming().userId == userId;
        allow update: if isOwner(userId) && isValidId(noteId) && incoming().userId == userId;
        allow delete: if isOwner(userId) && isValidId(noteId);
      }
    }
  }
}
